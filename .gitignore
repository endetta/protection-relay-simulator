.DS_Store

# Machine-local Claude Code permissions/settings (auto-modified per session)
.claude/settings.local.json

# Isolated git worktrees for parallel Claude Code sessions — never part of the working tree
.claude/worktrees/

# Runtime session-guard locks (SessionStart/SessionEnd; per-PID, never committed)
.claude/active-sessions/

# Teaching workspace (personal, not part of the distributed project)
.teach/
