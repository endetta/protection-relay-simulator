#!/usr/bin/env bash
# Two gates:
#   1) Parallel-session safety (main tree only): reject a commit on the SHARED
#      main working tree when two or more Claude sessions are live on it at once.
#   2) Verification (all trees): run tsc + vitest on source commits. Docs-only
#      commits (.md) are skipped. This is the test-first gate in CLAUDE.md.
#
# Parallel-session gate reasoning (from the original):
#   pre-commit runs without a session_id (git spawns it), so "reject if ANY
#   other lock exists" would misfire on a single session whose own lock is
#   present. Requiring >= 2 live locks trips exactly when two+ sessions share
#   the tree, and never disturbs a lone committer.
#
# In a worktree ([ -f .git ]) the session gate always passes: that is the
# correct, isolated place to work — but the VERIFICATION gate still runs there.
#
# Escape hatch (documented in CLAUDE.md): git commit --no-verify (explicit).
# Note that --no-verify also skips the verification gate; CI still gates the merge.

set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=session-lib.sh
source "$SCRIPT_DIR/../.claude/hooks/session-lib.sh"

REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
LOCKDIR="$REPO_ROOT/.claude/active-sessions"

# --- Gate 1: parallel-session safety (MAIN TREE ONLY) -----------------------
# The real working tree has .git as a directory; a worktree has it as a file.
if [ -d "$REPO_ROOT/.git" ]; then
  count="$(live_lock_count "$LOCKDIR")"
  if [ "$count" -ge 2 ]; then
    cat >&2 <<'EOF'
BLOCKED: 2+ Claude sessions are live on this shared main working tree at once.

Committing here can sweep up another session's staged files and produce the
mixed/duplicate commits this repo hit before. Move to an isolated worktree first:

  bash scripts/parallel-session.sh <your-task-name>

Work inside .claude/worktrees/<your-task-name> (own git index, own branch),
commit there, push the branch, then merge via PR. If you are deliberately
committing here anyway, run the exact command again with --no-verify (documented
escape hatch — only for explicit, deliberate cases).
EOF
    exit 1
  fi
fi

# --- Gate 2: verification (tsc + vitest) — ALL TREES ------------------------
# Skip if every staged file is a Markdown/doc change (no source to verify).
staged="$(git diff --cached --name-only)"
if [ -z "$staged" ]; then
  exit 0
fi
if ! printf '%s\n' "$staged" | grep -qv '\.md$'; then
  # All staged files are docs; nothing to type-check or test.
  exit 0
fi

echo "pre-commit: running verification gate (tsc --noEmit + vitest)..."
if ! npx tsc --noEmit; then
  echo "pre-commit: BLOCKED — tsc --noEmit failed. Task is not done." >&2
  exit 1
fi
if ! npx vitest run; then
  echo "pre-commit: BLOCKED — vitest run failed. Task is not done." >&2
  exit 1
fi

echo "pre-commit: verification gate PASSED."
exit 0
